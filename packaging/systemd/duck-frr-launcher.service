[Unit]
Description=DuckOS FRR privileged launcher daemon (internal TEST build)
Documentation=file:/opt/duckos/current/BUILD-INFO.json
# The launcher is independent of the Agent: it owns its
# RuntimeDirectory (duckos-agent, see below) and the FRR
# launcher socket lives there. The Agent's After=duck-frr-launcher
# relationship below still holds, so the Agent waits for the
# launcher's socket before its first FRR dial. Without
# RuntimeDirectory on this unit, the launcher needed the
# Agent to create /run/duckos-agent first, which produced
# an After=cycle (agent waits for launcher, launcher waits
# for agent) that systemd silently resolved by dropping
# one dep; the Agent then started before the launcher and
# left FRR disabled for the entire boot.
# B-010 (BETA.2): duck-frr-launcher is the canonical owner
# of FRR lifecycle. The installer masks every native FRR
# unit (frr.service / frr-watchfrr.service / per-daemon
# frr-zebra.service etc.) so a stock package upgrade cannot
# silently resurrect a competing zebra/bgpd. Conflicts= is
# belt-and-braces: even if a future package upgrade
# accidentally re-enables a native unit, systemd refuses
# to start it alongside duck-frr-launcher.
Conflicts=frr.service frr-watchfrr.service frr-zebra.service frr-bgpd.service frr-ospfd.service frr-ospf6d.service frr-ripd.service frr-ripngd.service frr-isisd.service frr-pimd.service frr-babeld.service frr-vrrpd.service frr-nhrpd.service frr-eigrpd.service frr-bfdd.service frr-fabricd.service frr-staticd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# /run/duckos-agent must exist before the launcher opens
# its socket. Declaring it on both this unit and the
# Agent unit lets systemd create it independently of
# whichever service boots first; RuntimeDirectoryMode=0750
# matches duck-agent.service / duck-wg-launcher.service
# exactly so no service clobbers the parent dir ownership
# on restart.
RuntimeDirectory=duckos-agent
RuntimeDirectoryMode=0750
# The launcher is a long-running privileged broker.
# It holds CAP_SETUID + CAP_SETGID + CAP_SETPCAP so
# that, when the Agent asks it to start an FRR
# daemon, the launcher can:
#
#   - setgroups([]) / setresgid / setresuid to drop
#     to the frr service user,
#   - drop CAP_SETUID/SETGID/SETPCAP from its
#     bounding set so the FRR child does not
#     inherit them,
#   - cap_set_proc({NET_ADMIN, NET_RAW,
#     NET_BIND_SERVICE, SYS_ADMIN}) to set the P/E/I
#     set FRR needs.
#
# The FRR child then runs as uid=frr with P/E =
# {NET_ADMIN, NET_RAW, NET_BIND_SERVICE, SYS_ADMIN}.
# NO CAP_SETUID/SETGID/SETPCAP. The CAP_SYS_ADMIN
# grant is required because Debian FRR 10.3's zebra
# binary unconditionally calls cap_set_proc with
# {NET_ADMIN, NET_RAW, SYS_ADMIN} and Debian's zebra
# build does NOT expose the upstream -S / --skip_runas
# flag (only bgpd does). See cmd/duck-frr-launcher
# /main.go for the architectural rationale. Per the
# BETA.2 architectural review, CAP_SYS_ADMIN on the
# FRR-only child is acceptable because the FRR
# process genuinely needs it. CAP_SYS_ADMIN MUST NOT
# reach duck-agent; the agent's bounding set stays
# empty.
#
# CAP_KILL is added because the launcher is the
# canonical owner of FRR lifetime (cmd/duck-frr-launcher
# /tracker.go). Every STOP command identity-verifies
# the PID via /proc/<pid>/cmdline, then signals SIGTERM
# (5s grace) and SIGKILL. The CAP_KILL grant is
# bounded to the launcher service; it never reaches
# duck-agent (which keeps its empty bounding set) and
# never reaches the FRR child (which inherits from
# the launcher's Effective set, not its bounding set).
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_KILL
AmbientCapabilities=
# KillMode=process keeps systemd from reaping the
# launcher's tracked FRR children when the launcher
# is stopped. The FRR daemons are owned by the
# agent's runtime, not by the launcher service; if
# systemd killed them via KillMode=control-group (the
# default), a launcher restart would orphan / kill
# / duplicate the pathspace. We let systemd kill
# only the launcher's own process; the FRR
# grandchildren survive in PID 1's process tree.
KillMode=process
# Allow exec'ing FRR with file caps: the file caps
# on /usr/lib/frr/{zebra,bgpd} are honored only when
# the calling process has NoNewPrivileges=no. This
# is the only place in the DuckOS stack that turns
# no_new_privs off; the agent itself keeps it on.
NoNewPrivileges=no
User=root
Group=duckos
SupplementaryGroups=frr frrvty
ExecStart=/usr/libexec/duckos/duck-frr-launcher --daemon --listen=/run/duckos-agent/frr-launcher.sock --socket-mode=0660 --socket-group=duckos
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
# The launcher writes a single line per command to
# stderr; cap it to avoid a hostile caller producing
# unbounded growth.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target