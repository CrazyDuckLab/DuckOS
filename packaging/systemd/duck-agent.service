[Unit]
Description=DuckOS privileged read-only system Agent (internal TEST build)
Documentation=file:/opt/duckos/current/BUILD-INFO.json
After=local-fs.target
Before=duck-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=duckos
# The agent owns the FRR pathspace (/var/lib/frr/<ps>, /run/frr/<ps>).
# The Debian FRR package ships /var/lib/frr/ owned frr:frr 0755 and
# /etc/frr/ owned root:frr. systemd's CapabilityBoundingSet strips
# CAP_DAC_OVERRIDE so User=root alone cannot write into /var/lib/frr
# or chown the pathspace to frr:frr. Granting SupplementaryGroups is
# the narrow standard way to give the agent the group membership it
# needs without expanding its capability set.
SupplementaryGroups=frr frrvty
ExecStart=/opt/duckos/current/bin/duck-agent --socket /run/duckos-agent/agent.sock --allowed-uid @DUCKOS_UID@ --environment test
RuntimeDirectory=duckos-agent
RuntimeDirectory=frr
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
UMask=0007
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=10
NoNewPrivileges=yes
# CAP_NET_ADMIN: routing / addressing (zebra, ip, network).
# CAP_NET_RAW:  raw socket probes (FRR zebra, ping).
# CAP_SETGID / CAP_SETUID: required for FRR's privs_init to
#   setgroups / setgid / setuid to the canonical `frr` user
#   before exec'ing zebra / bgpd. Without them, the daemon
#   aborts with "could not setgroups, Operation not permitted".
#   These are the canonical "drop privileges" capabilities
#   and grant no privileged file / network operations.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SETGID CAP_SETUID
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/duckos-agent /run/frr /var/lib/frr /var/lib/duckos-agent /var/lib/duckos-agent/network /var/lib/duckos-agent/ztp /var/lib/duckos-agent/wireguard /var/lib/duckos-agent/xray /var/lib/duckos-agent/frr /var/lib/duckos-agent/qos /var/lib/duckos-agent/vault /var/lib/duckos-agent/vault/records /etc/systemd/network
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
IPAddressDeny=any
LimitCORE=0
LimitNOFILE=512
MemoryHigh=128M
MemoryMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duck-agent
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
