[Unit]
Description=DuckOS WireGuard privileged launcher daemon (internal TEST build)
Documentation=file:/opt/duckos/current/BUILD-INFO.json
# B-005 (BETA.2): duck-agent correctly runs with
# CapabilityBoundingSet= empty and NoNewPrivileges=yes.
# It cannot exec /sbin/ip or /usr/bin/wg without losing
# the privilege boundary. The launcher is the dedicated
# privilege holder for every DuckOS WireGuard verb
# (ip link add type wireguard, ip address add/del, ip
# link set up/down, ip link del, wg setconf, wg show).
# CAP_NET_ADMIN is the ONLY capability DuckOS requires for
# WG. CAP_SYS_ADMIN, CAP_NET_RAW, CAP_SETUID, CAP_SETGID
# and CAP_SETPCAP are NOT required and MUST NOT be added
# unless a future operation independently needs them.
# Conflicts= (B-005) keeps the launcher in step with the
# FRR launcher's belt-and-braces policy: a competing
# WG runtime cannot start against an enabled launcher.
After=syslog.target network-online.target
After=duck-network-recover.service
After=duck-agent.service
Wants=duck-agent.service
# B-005 / B-009: a previous Conflicts= line that listed
# "wg-quick@.service" + "wg-quick@*.service" (or "wg-quick@*"
# alone) was rejected by systemd as "Invalid argument" at
# parse time. In some lab installs that caused the unit to
# be silently dropped from the multi-user.target Wants
# graph and the launcher never started on reboot. There is
# no valid Conflicts= value against the wg-quick@.service
# *template* (systemd does not accept template-name globs in
# Conflicts=). The correct enforcement is for the installer
# to `systemctl mask wg-quick@.service` (and the frr-launcher
# already follows that pattern for frr.service et al.).
# This unit therefore drops Conflicts= entirely and the
# installer takes care of the mask.

[Service]
Type=simple
# B-006 / BETA.2 PHASE-5 IPC FIX: /run/duckos-agent is
# owned solely by duck-agent.service. The launcher waits
# for the Agent (After=duck-agent.service) and binds its
# sockets into the Agent's already-created dir. The
# launcher itself does NOT declare RuntimeDirectory= so
# its restart never wipes the parent dir inode.
ExecStart=/opt/duckos/current/bin/duck-wg-launcher --listen=/run/duckos-agent/wg-launcher.sock --state=/var/lib/duckos/wireguard --secret=/run/duckos-agent/secret --ip=/sbin/ip --wg=/usr/bin/wg
Restart=on-failure
RestartSec=2s
User=root
Group=duckos
RuntimeDirectory=
# owned.json (DuckOS-owned interface tracking) lives
# under /var/lib/duckos/wireguard; ProtectSystem=strict
# makes the rest of / read-only so we MUST list it
# explicitly in ReadWritePaths, otherwise the launcher's
# atomic saveOwned() would fail silently. /run/duckos-agent
# is also writable so the launcher can create wg-launcher.sock
# and the secret file under it.
ReadWritePaths=/var/lib/duckos/wireguard /run/duckos-agent/secret

# CapabilityBoundingSet: CAP_NET_ADMIN. The launcher
# is responsible for ip link add type wireguard,
# ip address add/del, ip link set up/down, ip link del,
# ip route add/del (if applicable), wg setconf / wg show.
# NO other caps. SETUID / SETGID are forbidden (the
# launcher runs as root, drops nothing — it does not
# change uid because WG operations do not require a
# different uid; only the capability grants access).
# SETPCAP / NET_RAW are forbidden (no use).
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=no

# Hardening
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=strict
ProtectHome=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target