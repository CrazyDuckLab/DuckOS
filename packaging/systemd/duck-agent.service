[Unit]
Description=DuckOS privileged read-only system Agent (internal TEST build)
Documentation=file:/opt/duckos/current/BUILD-INFO.json
After=local-fs.target
# The Agent starts the FRR child through the
# duck-frr-launcher daemon. The daemon MUST be listening
# on /run/duckos-agent/frr-launcher.sock before the
# Agent's startup-time FRR init runs, otherwise the
# Agent's first FRR dial returns ENOENT and the FRR
# service is permanently marked unavailable until the
# Agent is restarted.
After=duck-frr-launcher.service
Wants=duck-frr-launcher.service
Before=duck-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# The Agent must perform directory setup for the FRR child
# (/run/frr/<ps>, /var/lib/frr/<ps>, /etc/frr/<ps>) before
# exec'ing the launcher, so it needs to be root.
User=root
# The Agent's primary group is duckos; SupplementaryGroups
# grants it membership in frr and frrvty so its gid-only
# chownToFRR helper can chown the pathspace dirs to the frr
# service group without needing CAP_CHOWN in its bounding
# set.
Group=duckos
SupplementaryGroups=frr frrvty
# The Agent holds NO capabilities in its bounding set.
# The privilege-separation model is:
#
#   - The Agent does MkdirAll, gid-only chown, chmod, and
#     write of frr.conf for the FRR child. None of those
#     require caps; UID 0 owner-rwx on the parent paths is
#     sufficient when ReadWritePaths is set.
#   - The Agent then dials the duck-frr-launcher daemon
#     over /run/duckos-agent/frr-launcher.sock and asks
#     it to start zebra/bgpd. The launcher (running in
#     its own systemd unit with the privilege-drop
#     model documented in cmd/duck-frr-launcher/main.go)
#     re-execs a child that drops to the frr service
#     user, drops SETUID/SETGID from its bounding set
#     BEFORE setresuid, and exec's
#     /usr/lib/frr/{zebra,bgpd} WITHOUT the `-S`
#     (--skip_runas) flag because Debian's zebra build
#     does NOT expose that flag.
#   - The FRR child runs as frr with P/E =
#     {NET_ADMIN, NET_RAW, NET_BIND_SERVICE, SYS_ADMIN,
#     SETPCAP}. CAP_SYS_ADMIN reaches the FRR child
#     because Debian FRR 10.3's zebra calls cap_set_proc
#     with CAP_SYS_ADMIN unconditionally; the file caps
#     installed by install.sh include cap_sys_admin and
#     cap_setpcap so the child's E has both. CAP_SYS_ADMIN
#     MUST NOT reach the Agent itself; the Agent's
#     bounding set stays empty.
#
# CAP_SYS_ADMIN is therefore NEVER granted to the Agent.
# The Agent's role is bounded; the launcher's role is
# bounded; the FRR child's role is bounded. None of them
# inherits the previous model's CAP_SYS_ADMIN except the
# FRR child, which the BETA.2 review determined needs it.
CapabilityBoundingSet=
AmbientCapabilities=
# NoNewPrivileges ensures setuid binaries and file-cap
# binaries run by the Agent cannot elevate privileges
# beyond what the Agent already has (which is none).
NoNewPrivileges=yes
ExecStart=/opt/duckos/current/bin/duck-agent --socket /run/duckos-agent/agent.sock --allowed-uid @DUCKOS_UID@ --environment test
RuntimeDirectory=duckos-agent
# /run/frr is created with 0751 so the FRR daemon (running
# as uid=frr) can traverse the parent to reach its
# pathspace dir /run/frr/<ps>. The pathspace dir's
# ownership and mode are the real access control surface;
# granting world rx on the parent does not expose any data.
RuntimeDirectory=frr
RuntimeDirectoryMode=0751
# Preserve /run/duckos-agent across restarts so the
# duck-frr-launcher daemon's Unix socket
# (/run/duckos-agent/frr-launcher.sock) survives when
# only the Agent restarts (eg during config reload). With
# RuntimeDirectoryPreserve=no, systemd wipes the dir on
# Agent stop and the launcher becomes unreachable until
# it itself is restarted.
RuntimeDirectoryPreserve=yes
ProtectControlGroups=yes
ProtectSystem=strict
# The Agent writes /var/lib/frr/<ps>/{frr.conf,vtysh.conf},
# /run/frr/<ps>/ (pathspace), /etc/frr/<ps>/ (vtysh.conf).
# ReadWritePaths only undoes the read-only remount that
# ProtectSystem=strict applies; it does not grant DAC
# bypass. The Agent must still own the parent paths
# (UID 0 + owner-rwx) to write into them.
ReadWritePaths=/run/duckos-agent /run/frr /var/lib/frr /var/lib/duckos-agent /var/lib/duckos-agent/network /var/lib/duckos-agent/ztp /var/lib/duckos-agent/wireguard /var/lib/duckos-agent/xray /var/lib/duckos-agent/frr /var/lib/duckos-agent/qos /var/lib/duckos-agent/vault /var/lib/duckos-agent/vault/records /etc/systemd/network /etc/frr
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHome=yes
MemoryMax=256M
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target