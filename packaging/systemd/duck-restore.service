[Unit]
Description=DuckOS confined restore service
After=local-fs.target
Before=duck-agent.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/duckos/duck-restore
RuntimeDirectory=duckos-restore
RuntimeDirectoryMode=0700
StateDirectory=duckos-restore
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=70
NoNewPrivileges=yes
# Preserve the original group on root-owned managed configuration files.
CapabilityBoundingSet=CAP_CHOWN
ProtectSystem=strict
ReadWritePaths=/var/lib/duckos/restore-live /var/lib/duckos-restore /run/duckos-restore
ReadOnlyPaths=/var/lib/duckos/restore-source
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=128
MemoryMax=512M
TasksMax=32
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
